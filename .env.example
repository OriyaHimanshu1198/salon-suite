# ── Salon Suite configuration ─────────────────────────────────────────────
# Copy to .env and edit. Never commit .env.

PORT=4321
SESSION_SECRET=change-me-to-a-long-random-string

# Salon identity (also editable in the admin UI → Settings)
SALON_NAME=Lumière Hair & Beauty
SALON_TIMEZONE=Europe/London

# WhatsApp — leave blank to use click-to-send wa.me links
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
